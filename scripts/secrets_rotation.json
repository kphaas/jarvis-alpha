{
  "_meta": {"config_version": 1, "last_edited": "2026-04-29"},
  "secrets": {
    "GITHUB_TOKEN": {
      "description": "GitHub Personal Access Token",
      "rotation_days": 90,
      "nodes": ["brain", "gateway", "endpoint", "sandbox"],
      "restarts": [
        {"node": "brain",   "service": "com.jarvis.alpha.brain",     "health_url": "https://jarvis-brain.tail40ed36.ts.net:8186/health"},
        {"node": "sandbox", "service": "com.jarvis.forge.dashboard", "health_url": "https://jarvis-sandbox.tail40ed36.ts.net:5001/api/health"}
      ],
      "verify": {"type": "github_api", "expect_login": "kphaas"}
    },
    "ALPHA_PIN": {
      "description": "Alpha UI admin PIN",
      "rotation_days": 90,
      "nodes": ["brain"],
      "restarts": [
        {"node": "brain", "service": "com.jarvis.alpha.brain", "health_url": "https://jarvis-brain.tail40ed36.ts.net:8186/health"}
      ],
      "verify": {"type": "none"}
    },
    "POSTGRES_PASSWORD": {
      "description": "Postgres jarvisbrain role password (Brain-local)",
      "rotation_days": 180,
      "nodes": ["brain"],
      "restarts": [
        {"node": "brain", "service": "com.jarvis.alpha.brain",    "health_url": "https://jarvis-brain.tail40ed36.ts.net:8186/health"},
        {"node": "brain", "service": "com.jarvis.alpha.buddy",    "health_url": null},
        {"node": "brain", "service": "com.jarvis.alpha.executor", "health_url": null},
        {"node": "brain", "service": "com.jarvis.family.api",     "health_url": null}
      ],
      "verify": {"type": "none"},
      "requires_alter_role": true,
      "db_role": "jarvisbrain",
      "db_name": "jarvis_alpha"
    },
    "TEMPORAL_DB_PASSWORD": {
      "description": "Postgres temporal role password (Temporal server)",
      "rotation_days": 180,
      "nodes": ["brain"],
      "restarts": [
        {"node": "brain", "service": "com.jarvis.alpha.temporal.server", "health_url": null}
      ],
      "verify": {"type": "none"},
      "requires_alter_role": true,
      "db_role": "temporal",
      "db_name": "temporal"
    }
  }
}
