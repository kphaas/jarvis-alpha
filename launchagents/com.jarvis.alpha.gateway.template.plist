<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
<key>Label</key>
<string>com.jarvis.alpha.gateway</string>
<key>ProgramArguments</key>
<array>
<string>/bin/bash</string>
<string>{{HOME}}/jarvis-alpha/scripts/start_alpha_gateway.sh</string>
</array>
<key>RunAtLoad</key>
<true/>
<key>KeepAlive</key>
<true/>
<key>WorkingDirectory</key>
<string>{{HOME}}/jarvis-alpha</string>
<key>StandardOutPath</key>
<string>{{HOME}}/jarvis-alpha/logs/alpha_gateway.log</string>
<key>StandardErrorPath</key>
<string>{{HOME}}/jarvis-alpha/logs/alpha_gateway_error.log</string>
<key>EnvironmentVariables</key>
<dict>
<key>GIT_TERMINAL_PROMPT</key>
<string>0</string>
<key>JARVIS_NODE</key>
<string>gateway</string>
<key>SECRETS_FILE</key>
<string>{{HOME}}/jarvis/.secrets</string>
</dict>
</dict>
</plist>
