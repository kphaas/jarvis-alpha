<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
<key>Label</key>
<string>com.jarvis.alpha.school-email</string>
<key>ProgramArguments</key>
<array>
<string>/bin/bash</string>
<string>{{HOME}}/jarvis-alpha/scripts/start_alpha_school_email.sh</string>
</array>
<key>StartCalendarInterval</key>
<dict>
<key>Hour</key>
<integer>23</integer>
<key>Minute</key>
<integer>0</integer>
</dict>
<key>WorkingDirectory</key>
<string>{{HOME}}/jarvis-alpha</string>
<key>StandardOutPath</key>
<string>{{HOME}}/jarvis-alpha/logs/alpha_school_email.log</string>
<key>StandardErrorPath</key>
<string>{{HOME}}/jarvis-alpha/logs/alpha_school_email_error.log</string>
<key>EnvironmentVariables</key>
<dict>
<key>GIT_TERMINAL_PROMPT</key>
<string>0</string>
<key>JARVIS_NODE</key>
<string>brain</string>
<key>SECRETS_FILE</key>
<string>{{HOME}}/jarvis/.secrets</string>
</dict>
</dict>
</plist>
